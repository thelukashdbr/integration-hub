# Copy to .env and fill in the two secrets below. Never commit .env.

# Postgres connection. docker-compose overrides this to point at the postgres service.
DATABASE_URL=postgresql+psycopg://integration_hub:integration_hub@localhost:5432/integration_hub

# Fernet key used to encrypt credential secrets at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Static key clients must send as the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_API_KEY=

# Default timeout (seconds) for outbound calls to external APIs.
HTTP_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
